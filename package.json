{
  "name": "dante-astro-theme",
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"./**/*.{astro,js,cjs,mjs,ts,cts,mts,json,md,mdx,html,css,scss,less,yaml,yml}\"",
    "format:fix": "prettier --write \"./**/*.{astro,js,cjs,mjs,ts,cts,mts,json,md,mdx,html,css,scss,less,yaml,yml}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.3",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.2.6",
    "@tailwindcss/vite": "^4.0.17",
    "astro": "^5.5.6",
    "marked": "^15.0.7",
    "tailwindcss": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@tailwindcss/typography": "^0.5.16",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
